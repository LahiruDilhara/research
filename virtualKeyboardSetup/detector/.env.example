# Detector Runtime: Environment Configuration

# ── Application ────────────────────────────────────────────────────────────────
APP_TITLE=Virtual Keyboard Detector
APP_THEME=Dark

# ── Camera ─────────────────────────────────────────────────────────────────────
# Default camera index; overridden at runtime from the Camera Select view
CAMERA_INDEX=0

# ── Pipeline ───────────────────────────────────────────────────────────────────
TARGET_FPS=12.0
WINDOW_SIZE=5
SHIFT_SIZE=3

# ── MediaPipe ──────────────────────────────────────────────────────────────────
# Path to hand_landmarker.task file (downloaded automatically if missing)
MEDIAPIPE_MODEL_PATH=hand_landmarker.task

# ── AI Model Plugins ───────────────────────────────────────────────────────────
# Directory scanned for AI model plugin files (relative to detector root)
AI_MODEL_PLUGINS_DIR=ai_model_plugins
PLUGINS_DIR=ai_model_plugins

# ── Touch Detection & Debouncing ───────────────────────────────────────────────
# Minimum model output probability to count as a touch event
TOUCH_THRESHOLD=0.55
TOUCH_ONSET_THRESHOLD=0.55
TOUCH_RELEASE_THRESHOLD=0.40

# ── Filtration Thresholds (matching process.sh) ────────────────────────────────
# Maximum stationary palm joint displacement / L_hand between Frame 1 & 5 (Step 7)
HAND_MOVEMENT_THRESHOLD=0.155

# Window tracking confidence quality thresholds (Step 10)
QUALITY_MIN_AVG_SCORE=0.65
QUALITY_MIN_FRAME_SCORE=0.45
QUALITY_MAX_SCORE_DROP=0.35

# Zero-velocity touch kinetic speed noise floor in L_hand / step (Step 9)
MIN_KINETIC_SPEED_THRESHOLD=0.008

# ── AprilTag Homography ────────────────────────────────────────────────────────
# Minimum detected markers required before accepting a homography matrix
APRILTAG_MIN_MARKERS=1
# Exponential smoothing factor for H matrix (0=instant, 1=never update)
APRILTAG_SMOOTHING_ALPHA=0.75

